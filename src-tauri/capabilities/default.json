{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "PinShot desktop capability",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "dialog:default",
    "global-shortcut:default"
  ]
}
